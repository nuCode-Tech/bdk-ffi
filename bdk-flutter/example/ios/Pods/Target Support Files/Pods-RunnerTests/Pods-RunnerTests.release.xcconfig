CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
DEAD_CODE_STRIPPING = NO
DEFINES_MODULE = YES
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/bdk_flutter" "${PODS_CONFIGURATION_BUILD_DIR}/integration_test"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/bdk_flutter/bdk_flutter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/integration_test/integration_test.framework/Headers"
OTHER_LDFLAGS = $(inherited) -framework "UIKit" -framework "bdk_flutter" -framework "integration_test" -force_load $(PODS_TARGET_SRCROOT)/libbdkffi.a
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
